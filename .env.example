# Copier ce fichier en `.env` et remplir les valeurs avant de lancer le
# site en local ou de le déployer. Aucune de ces variables ne doit être
# préfixée par PUBLIC_ : elles ne doivent jamais atteindre le navigateur.

# --- Supabase (stockage des messages "Parle-nous", "Rejoignez-nous" et
#      "Soutenez-nous") --------------------------------------------------
# URL du projet Supabase, ex. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Clé "service_role" (Project Settings → API → service_role secret).
# Elle contourne les règles RLS : ne jamais l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Espace d'administration ("Parle-nous") -----------------------------
# Hash du mot de passe d'accès à /admin, généré avec :
#   node scripts/hash-password.mjs "le-mot-de-passe-choisi"
ADMIN_PASSWORD_HASH=
# Chaîne aléatoire longue servant à signer les sessions admin. Générer par
# exemple avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Paiement Mobile Money et carte ("Soutenez-nous") — prestataire nyole -
# Clé secrète nyole : espace nyole → API et journaux → clé secrète.
#   - Clé de test  : af_test_sec_...  (paiements simulés, aucun argent réel)
#   - Clé de prod  : af_live_sec_...  (paiements réels)
# Tant que cette variable est vide, /api/dons n'enregistre qu'une intention
# de don (voir src/lib/dons-config.ts) et ne déclenche jamais de paiement
# réel. Ne jamais exposer cette clé côté client (pas de préfixe PUBLIC_).
#
# Webhook : dans l'espace nyole (API et journaux → Webhooks), renseigner
# l'URL https://jeunechretien.org/api/webhooks/nyole et cocher au minimum
# les événements payment.completed, payment.failed et payment.cancelled.
# La signature des webhooks est vérifiée avec cette même clé secrète
# (voir src/lib/nyole.ts) — aucune variable supplémentaire n'est requise.
NYOLE_SECRET_KEY=
