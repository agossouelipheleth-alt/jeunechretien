# Copier ce fichier en `.env` et remplir les valeurs avant de lancer le
# site en local ou de le déployer. Aucune de ces variables ne doit être
# préfixée par PUBLIC_ : elles ne doivent jamais atteindre le navigateur.

# --- Supabase (stockage des messages "Parle-nous", "Rejoignez-nous" et
#      "Soutenez-nous") --------------------------------------------------
# URL du projet Supabase, ex. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Clé "service_role" (Project Settings → API → service_role secret).
# Elle contourne les règles RLS : ne jamais l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Espace d'administration ("Parle-nous") -----------------------------
# Hash du mot de passe d'accès à /admin, généré avec :
#   node scripts/hash-password.mjs "le-mot-de-passe-choisi"
ADMIN_PASSWORD_HASH=
# Chaîne aléatoire longue servant à signer les sessions admin. Générer par
# exemple avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Paiement Mobile Money ("Soutenez-nous") -----------------------------
# NON CONFIGURÉ pour l'instant — tant que cette section reste vide,
# /api/dons n'enregistre qu'une intention de don (voir
# src/lib/dons-config.ts) et ne déclenche jamais de paiement réel.
# Pour activer un paiement réel : choisir un agrégateur compatible
# Bénin/Mobile Money (ex. FedaPay, Kkiapay, CinetPay, PayDunya — à valider
# selon les opérateurs et frais réels), renseigner son identifiant ici et
# implémenter l'appel dans src/pages/api/dons.ts (voir le TODO qui y est
# indiqué).
MOBILE_MONEY_PROVIDER=
# Clé API / secret du prestataire choisi — nom exact à adapter selon le
# prestataire retenu. Ne jamais exposer côté client.
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=
