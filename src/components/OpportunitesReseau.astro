---
import { Image } from "astro:assets";
import opportunitesPhoto from "../assets/photos/opportunites-reseau-echange.jpg";

const formes = [
  "Opportunités de formation",
  "Mentorat",
  "Événements",
  "Opportunités professionnelles",
  "Appels à projets",
  "Ressources",
  "Mise en relation",
] as const;
---

<section id="opportunites-reseau" class="container-content px-4 py-24 sm:px-6 lg:py-32">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="reveal-group flex flex-col items-start gap-6 lg:order-last lg:col-span-7">
      <p class="kicker">05 – Opportunités & réseau</p>
      <h2 class="domaine-detail-title">
        Créer des connexions qui peuvent ouvrir de nouvelles possibilités.
      </h2>
      <div class="flex w-full flex-col gap-4 text-ink/70">
        <p>
          L'accès à la bonne information ou à la bonne personne peut parfois
          faire une différence dans un parcours.
        </p>
        <p>
          Jeune Chrétien souhaite faciliter la découverte et le partage
          d'opportunités utiles aux jeunes.
        </p>
      </div>

      <div class="w-full">
        <p class="formats-label">Cela peut prendre la forme de</p>
        <ul class="formats-list reveal-group">
          {formes.map((forme) => <li>{forme}</li>)}
        </ul>
      </div>
    </div>

    <div class="reveal-group domaine-media lg:order-first lg:col-span-5">
      <Image
        src={opportunitesPhoto}
        alt="Trois jeunes professionnels penchés ensemble sur un document, en pleine discussion."
        class="domaine-photo w-full reveal-photo"
        widths={[400, 640, 800, 1000]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  section {
    scroll-margin-top: 6.5rem;
  }

  .kicker {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .domaine-detail-title {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    line-height: 1.25;
    max-width: 28rem;
  }

  .domaine-photo {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  .formats-label {
    margin-bottom: 0.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .formats-list {
    display: flex;
    flex-direction: column;
  }
  .formats-list li {
    padding-block: 0.875rem;
    border-top: 1px solid var(--color-border);
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    transition: color 150ms var(--ease-out-site);
  }
  .formats-list li:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .formats-list li:hover {
    color: var(--color-accent);
  }

  @media (min-width: 64rem) {
    .domaine-media {
      position: sticky;
      top: 6.5rem;
      align-self: start;
    }
  }
</style>
