---
// Timeline à 5 étapes — même technique que NotreEvolution.astro (Qui
// sommes-nous ?), horizontale/desktop verticale/mobile, mais reprend ici
// la logique Informer → Inspirer → Former → Accompagner de la homepage
// en y ajoutant Engager, propre à cette page centrée sur l'action.
const steps = [
  {
    number: "01",
    title: "Informer",
    text: "Donner accès à des informations et des ressources utiles.",
  },
  {
    number: "02",
    title: "Inspirer",
    text: "Faire découvrir des parcours, des expériences et des possibilités.",
  },
  {
    number: "03",
    title: "Former",
    text: "Développer les connaissances et les compétences.",
  },
  {
    number: "04",
    title: "Accompagner",
    text: "Aller plus loin grâce aux échanges, au mentorat et aux initiatives.",
  },
  {
    number: "05",
    title: "Engager",
    text: "Encourager le passage à l'action.",
  },
] as const;
---

<section id="notre-methode" class="container-content px-4 py-24 sm:px-6 lg:py-32">
  <div class="reveal-group mx-auto flex max-w-2xl flex-col items-center gap-6 text-center">
    <p class="kicker">Notre méthode</p>
    <h2 class="methode-title">Du contenu à l'action.</h2>
  </div>

  <ol class="methode-timeline mt-16 lg:mt-20">
    {
      steps.map((step) => (
        <li class="methode-step reveal-item">
          <span class="methode-number" aria-hidden="true">
            {step.number}
          </span>
          <div class="methode-content">
            <h3 class="methode-step-title">{step.title}</h3>
            <p class="methode-text">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="methode-cta reveal-item mx-auto mt-16 flex max-w-md flex-col items-center gap-4 text-center lg:mt-20">
    <p class="text-ink/70">Une question ? Une préoccupation ? Tu peux en parler.</p>
    <button type="button" class="methode-cta-button" data-tpp-open="">
      Tu peux en parler
    </button>
  </div>
</section>

<style>
  section {
    scroll-margin-top: 6.5rem;
  }

  .kicker {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .methode-title {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    line-height: 1.25;
  }

  .methode-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1.5rem;
    padding-block: 0.75rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    background-color: transparent;
    color: var(--color-accent);
    font-weight: 500;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background-color 150ms var(--ease-out-site);
  }
  .methode-cta-button:hover {
    background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }
  .methode-cta-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .methode-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .methode-timeline::before {
    content: "";
    position: absolute;
    left: 1.25rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .methode-step {
    position: relative;
    display: flex;
    gap: 1.25rem;
  }

  .methode-number {
    position: relative;
    z-index: 1;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    background-color: var(--color-bg);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .methode-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 0.375rem;
  }

  .methode-step-title {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
  }

  .methode-text {
    max-width: 20rem;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    font-size: 0.9375rem;
  }

  /* Desktop : ligne horizontale, 5 colonnes égales — la ligne relie le
     centre du 1er badge au centre du dernier (1/10 et 9/10 pour 5
     colonnes, même calcul que la timeline à 3 étapes de
     NotreEvolution.astro). */
  @media (min-width: 64rem) {
    .methode-timeline {
      flex-direction: row;
      gap: 0;
    }
    .methode-timeline::before {
      left: 10%;
      right: 10%;
      top: 1.25rem;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .methode-step {
      flex: 1;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-inline: 1rem;
    }
    .methode-content {
      align-items: center;
      padding-top: 1.25rem;
    }
    .methode-text {
      max-width: 14rem;
    }
  }
</style>
