---
import { Image } from "astro:assets";
import developpementPhoto from "../assets/photos/developpement-personnel-atelier.jpg";

const formats = [
  "Webinaires",
  "Masterclass",
  "Ateliers",
  "Ressources pratiques",
  "Témoignages",
  "Sessions d'échange",
] as const;
---

<section id="developpement-personnel" class="container-content px-4 py-24 sm:px-6 lg:py-32">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="reveal-group flex flex-col items-start gap-6 lg:order-last lg:col-span-7">
      <p class="kicker">02 – Développement personnel</p>
      <h2 class="domaine-detail-title">Développer ce que l'on porte en soi.</h2>
      <p class="text-ink/70">
        Grandir ne concerne pas uniquement la vie spirituelle. Les jeunes
        doivent également développer les talents et dons de Dieu en eux,
        apprendre à mieux se connaître et acquérir des compétences utiles à
        leur parcours.
      </p>

      <div class="w-full">
        <p class="formats-label">Formats</p>
        <ul class="formats-list reveal-group">
          {formats.map((format) => <li>{format}</li>)}
        </ul>
      </div>
    </div>

    <div class="reveal-group domaine-media lg:order-first lg:col-span-5">
      <Image
        src={developpementPhoto}
        alt="Un jeune homme présentant devant un tableau de conférence, entouré de collègues attentifs."
        class="domaine-photo w-full reveal-photo"
        widths={[400, 640, 800, 1000]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  section {
    scroll-margin-top: 6.5rem;
  }

  .kicker {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .domaine-detail-title {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    line-height: 1.25;
    max-width: 28rem;
  }

  .domaine-photo {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  .formats-label {
    margin-bottom: 0.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .formats-list {
    display: flex;
    flex-direction: column;
  }
  .formats-list li {
    padding-block: 0.875rem;
    border-top: 1px solid var(--color-border);
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    transition: color 150ms var(--ease-out-site);
  }
  .formats-list li:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .formats-list li:hover {
    color: var(--color-accent);
  }

  @media (min-width: 64rem) {
    .domaine-media {
      position: sticky;
      top: 6.5rem;
      align-self: start;
    }
  }
</style>
