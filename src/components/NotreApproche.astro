---
import { Image } from "astro:assets";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import portraitSouriant from "../assets/photos/collage-portrait-souriant.png";
import discussionUrbain from "../assets/photos/collage-discussion-urbain.jpg";
import lectureSerre from "../assets/photos/collage-lecture-serre.png";
import mouvementEnergie from "../assets/photos/collage-mouvement-energie.jpg";

const items = [
  {
    number: "01",
    title: "Informer",
    description:
      "Des contenus qui répondent aux questions et préoccupations des jeunes.",
  },
  {
    number: "02",
    title: "Inspirer",
    description:
      "Des témoignages, réflexions et parcours qui donnent envie d'avancer.",
  },
  {
    number: "03",
    title: "Former",
    description:
      "Des ressources et programmes pour développer ses connaissances et ses compétences.",
  },
  {
    number: "04",
    title: "Accompagner",
    description:
      "Des échanges, conseils, mentorats et initiatives pour aller plus loin.",
  },
] as const;

const fragments = [
  {
    ratio: "4/5",
    label:
      "Photo à venir – portrait rapproché d'un jeune souriant (fragment collage)",
    image: portraitSouriant,
    alt: "Portrait rapproché d'un jeune homme souriant en extérieur.",
  },
  {
    ratio: "1/1",
    label:
      "Photo à venir – groupe de jeunes en discussion, extérieur urbain (fragment collage)",
    image: discussionUrbain,
    alt: "Un groupe de jeunes souriants, regardant ensemble un téléphone.",
  },
  {
    ratio: "4/5",
    label:
      "Photo à venir – jeune en pleine lecture, plan serré (fragment collage)",
    image: lectureSerre,
    alt: "Une jeune femme en train de lire un livre, plan rapproché.",
  },
  {
    ratio: "3/4",
    label:
      "Photo à venir – jeunes en mouvement, énergie et spontanéité (fragment collage)",
    image: mouvementEnergie,
    alt: "Une jeune femme sautant avec énergie dans une rue, cheveux et bras en mouvement.",
  },
] as const;
---

<section id="notre-approche" class="approche-section">
  <div class="container-content px-4 py-24 sm:px-6 lg:py-32">
    <div class="grid gap-16 lg:grid-cols-2 lg:items-start lg:gap-20">
      <div class="reveal-group flex flex-col gap-10">
        <div class="flex flex-col items-start gap-6">
          <p class="kicker-dark">Notre approche</p>
          <h2 class="approche-title">
            Informer. Inspirer. Former. Accompagner.
          </h2>
        </div>

        <ul class="approche-list">
          {
            items.map((item) => (
              <li class="approche-item">
                <span class="approche-number" aria-hidden="true">
                  {item.number}
                </span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal-group collage">
        {
          fragments.map((fragment, i) => (
            <div class={`collage-item collage-item-${i + 1} reveal-photo`}>
              {fragment.image ? (
                <Image
                  src={fragment.image}
                  alt={fragment.alt}
                  class="h-full w-full object-cover"
                  style={`aspect-ratio: ${fragment.ratio};`}
                  widths={[300, 500, 700]}
                  sizes="(min-width: 1024px) 25vw, 45vw"
                  loading="lazy"
                />
              ) : (
                <MediaPlaceholder
                  ratio={fragment.ratio}
                  label={fragment.label}
                  dark
                  class="w-full h-full"
                />
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  section {
    scroll-margin-top: 6.5rem;
  }

  .approche-section {
    /* Fond volontairement fixe (pas var(--color-ink), qui s'éclaircit en
       thème sombre) : cette section reste un bloc sombre distinct quel
       que soit le thème du site. */
    background-color: #070500;
    color: #fff;
  }

  .kicker-dark {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-on-dark);
  }

  .approche-title {
    color: #fff;
    font-size: clamp(1.75rem, 1.3rem + 2vw, 3rem);
    line-height: 1.15;
  }

  .approche-list {
    display: flex;
    flex-direction: column;
  }

  .approche-item {
    display: flex;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .approche-item:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }

  .approche-number {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-accent-on-dark);
  }

  .approche-item h3 {
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .approche-item p {
    color: rgb(255 255 255 / 0.65);
  }

  /* Collage éditorial — fragments légèrement décalés, pas une grille sage. */
  .collage {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding-block: 1rem;
  }
  .collage-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .collage-item-1 {
    transform: rotate(-3deg) translateY(0.5rem);
  }
  .collage-item-2 {
    transform: rotate(2deg) translateY(-1rem);
  }
  .collage-item-3 {
    transform: rotate(2deg) translateY(1.5rem);
  }
  .collage-item-4 {
    transform: rotate(-2deg) translateY(-0.5rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .collage-item {
      transform: none !important;
    }
  }
</style>
