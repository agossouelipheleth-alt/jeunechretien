---
import { Image } from "astro:assets";
import heroPhoto from "../assets/photos/hero-cqnf-groupe.png";
---

<section id="hero-cqnf" class="hero-cqnf-section">
  <Image
    src={heroPhoto}
    alt="Un groupe de jeunes adultes souriants, marchant et échangeant ensemble sous des palmiers."
    class="hero-cqnf-media"
    widths={[640, 1024, 1440, 1920, 2400]}
    sizes="100vw"
    loading="eager"
  />
  <div class="hero-cqnf-scrim" aria-hidden="true"></div>

  <div class="container-content hero-cqnf-content reveal-group">
    <p class="kicker">Ce que nous faisons</p>
    <h1 class="hero-cqnf-title">
      Donner aux jeunes les moyens de grandir, d'apprendre et d'agir.
    </h1>
    <p class="hero-cqnf-text">
      À travers le numérique, Jeune Chrétien développe des contenus, des
      ressources, des activités et des initiatives destinés à accompagner
      les jeunes dans les différentes dimensions de leur vie.
    </p>
    <a href="#nos-domaines-action" class="hero-cqnf-cta">
      <span>Découvrir nos actions</span>
      <span class="hero-cqnf-arrow" aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  .hero-cqnf-section {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 85vh;
    overflow: hidden;
  }

  .hero-cqnf-media {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-cqnf-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(7 5 0 / 0.85) 0%,
      rgb(7 5 0 / 0.35) 55%,
      rgb(7 5 0 / 0.1) 100%
    );
  }

  .hero-cqnf-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 42rem;
    padding-inline: 1rem;
    padding-block: 4rem 5rem;
    color: #fff;
  }
  @media (min-width: 40rem) {
    .hero-cqnf-content {
      padding-inline: 1.5rem;
    }
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-on-dark);
  }

  .hero-cqnf-title {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    line-height: 1.1;
    font-weight: 600;
  }

  .hero-cqnf-text {
    max-width: 34rem;
    color: rgb(255 255 255 / 0.85);
  }

  .hero-cqnf-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding-inline: 1.5rem;
    padding-block: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: var(--radius-md);
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 150ms var(--ease-out-site),
      background-color 150ms var(--ease-out-site);
  }
  .hero-cqnf-cta:hover {
    border-color: #fff;
    background-color: rgb(255 255 255 / 0.08);
  }
  .hero-cqnf-arrow {
    transition: transform 150ms var(--ease-out-site);
  }
  .hero-cqnf-cta:hover .hero-cqnf-arrow {
    transform: translateY(3px);
  }
</style>
