---
// À placer en fin d'article de blog (une fois le blog construit).
// Ouvre la modale globale "Tu peux en parler" directement sur la
// catégorie "question" (voir TuPeuxEnParler.astro) plutôt que de
// naviguer vers une page — cohérent avec le brief transversal.
---

<div class="blog-parle-cta">
  <p class="blog-parle-text">Une question après avoir lu cet article ? Tu peux en parler.</p>
  <button type="button" class="cta-text" data-tpp-open="question">
    <span>Poser une question</span>
    <span class="cta-arrow" aria-hidden="true">→</span>
  </button>
</div>

<style>
  .blog-parle-cta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-alt);
  }

  .blog-parle-text {
    font-weight: 600;
  }

  .cta-text {
    position: relative;
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    border: none;
    background: none;
    padding: 0;
    color: var(--color-ink);
    font: inherit;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .cta-text::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out-site);
  }
  .cta-text:hover,
  .cta-text:focus-visible {
    color: var(--color-accent);
  }
  .cta-text:hover::after,
  .cta-text:focus-visible::after {
    transform: scaleX(1);
  }
  .cta-arrow {
    transition: transform 150ms var(--ease-out-site);
  }
  .cta-text:hover .cta-arrow,
  .cta-text:focus-visible .cta-arrow {
    transform: translateX(4px);
  }
</style>
