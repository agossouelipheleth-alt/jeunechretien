---
import { Image } from "astro:assets";
import heroCouplePointing from "../assets/photos/hero-couple-pointing.png";
import heroCoupleHug from "../assets/photos/hero-couple-hug.png";
import heroCoupleThumbsUp from "../assets/photos/hero-couple-thumbsup.png";

// Diaporama en fondu enchaîné (brief : la 1ère image apparaît, laisse
// place à la 2e, puis à la 3e, puis la 1ère revient — boucle infinie).
// Animation CSS pure (pas de JS) : les 3 images sont superposées, une
// même animation leur est appliquée avec un décalage négatif chacune
// (voir .hero-slide-2/-3) pour les déphaser sur le même cycle de 9s.
const slides = [
  {
    image: heroCoupleHug,
    alt: "Un jeune homme et une jeune femme souriants, elle l'enlaçant par-derrière.",
  },
  {
    image: heroCouplePointing,
    alt: "Une jeune femme et un jeune homme souriants, côte à côte, elle pointant du doigt vers la gauche.",
  },
  {
    image: heroCoupleThumbsUp,
    alt: "Un jeune homme et une jeune femme souriants, elle l'enlaçant par-derrière, tous deux le pouce levé.",
  },
] as const;
---

<section class="hero-section">
  <div
    class="container-content grid gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16"
  >
    <div class="reveal-group flex flex-col items-start gap-6 self-center lg:gap-8 lg:self-start lg:pt-24">
      <p class="hero-kicker">Jeune Chrétien</p>
      <h1 class="hero-title">
        <span class="block">Grandir dans la foi.</span>
        <span class="block">Se développer.</span>
        <span class="block">Servir.</span>
      </h1>
      <p class="max-w-md text-ink/70">
        Nous aidons les jeunes chrétiens à grandir dans leur foi, développer
        leur potentiel et s'engager, là où ils sont : en ligne.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/qui-sommes-nous" class="btn-primary">Découvrir Jeune Chrétien</a>
        <a href="/blog" class="btn-secondary">Explorer nos contenus</a>
      </div>
    </div>

    <div class="reveal-group hero-media">
      <div class="hero-slideshow">
        {
          slides.map((slide, i) => (
            <Image
              src={slide.image}
              alt={slide.alt}
              class={`hero-cutout hero-slide hero-slide-${i + 1}`}
              widths={[400, 600, 800, 1154]}
              sizes="(min-width: 1024px) 40vw, 70vw"
              format="webp"
              quality={85}
              loading="eager"
              fetchpriority={i === 0 ? "high" : "auto"}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    min-height: 85vh;
    min-height: 85svh;
    background-color: var(--color-hero-bg);
  }
  .hero-section > .container-content {
    flex: 1;
  }

  @media (max-width: 63.9375rem) {
    .hero-section {
      min-height: 0;
      padding-block: 3rem;
    }
  }

  .hero-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-title {
    text-transform: uppercase;
    font-size: clamp(2rem, 1.3rem + 2vw, 3.25rem);
    line-height: 1.08;
    white-space: nowrap;
  }

  @media (max-width: 26.5625rem) {
    .hero-title {
      white-space: normal;
      text-wrap: balance;
    }
  }

  .hero-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Boîte à taille réelle et fixe (contrairement à une boîte qui ne
     tirerait sa hauteur que du contenu de ses enfants) : les images
     étant en position absolue à l'intérieur (voir .hero-slide), sans
     cette taille explicite la boîte s'effondrerait à une hauteur nulle
     et les photos déborderaient par-dessus les éléments voisins — c'est
     exactement le bug corrigé ici. */
  .hero-slideshow {
    position: relative;
    width: 100%;
    max-width: 26rem;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 64rem) {
    .hero-slideshow {
      max-width: 32rem;
    }
  }

  .hero-cutout {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Les 3 images se superposent exactement ; seule l'opacité change.
     Chaque image a un « tour » de 2.5s (cycle total 7.5s = 3 × 2.5s) :
     0.5s de fondu entrant, 2s de plein affichage, 0.5s de fondu sortant.
     Le fondu sortant d'une image déborde volontairement de 0.5s sur le
     tour suivant, exactement superposé au fondu entrant de l'image qui
     la remplace (opacités inverses, linéaires : leur somme reste
     toujours égale à 1). Résultat : à tout instant, au moins une image
     est à pleine opacité ou les deux se chevauchent en fondu — le fond
     de la section n'est jamais visible, contrairement à l'ancienne
     version qui laissait un blanc entre deux photos. */
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: hero-crossfade 7.5s linear infinite;
  }
  /* Décalage négatif : chaque image démarre à un point différent de la
     même animation, ce qui crée le cycle 1 → 2 → 3 → 1 → … */
  .hero-slide-1 {
    animation-delay: -7.5s;
  }
  .hero-slide-2 {
    animation-delay: -5s;
  }
  .hero-slide-3 {
    animation-delay: -2.5s;
  }

  @keyframes hero-crossfade {
    0% {
      opacity: 0;
    }
    6.667% {
      opacity: 1;
    }
    33.333% {
      opacity: 1;
    }
    40%,
    100% {
      opacity: 0;
    }
  }

  /* Mobile/tablette uniquement : la 2e image est retirée du diaporama,
     qui repasse d'un cycle à 3 photos (7.5s / 2.5s de tour chacune) à un
     cycle à 2 photos (5s / 2.5s de tour chacune — même durée de tour et
     mêmes proportions fondu/affichage/chevauchement par image). */
  @media (max-width: 63.9375rem) {
    .hero-slide-2 {
      display: none;
    }
    .hero-slide-1,
    .hero-slide-3 {
      animation-name: hero-crossfade-duo;
      animation-duration: 5s;
    }
    .hero-slide-1 {
      animation-delay: -5s;
    }
    .hero-slide-3 {
      animation-delay: -2.5s;
    }
  }

  @keyframes hero-crossfade-duo {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    50% {
      opacity: 1;
    }
    60%,
    100% {
      opacity: 0;
    }
  }

  /* Pas d'animation permanente pour qui la refuse : la 1ère image reste
     simplement affichée. */
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none;
      opacity: 0;
    }
    .hero-slide-1 {
      opacity: 1;
    }
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1.75rem;
    padding-block: 0.875rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-accent);
    transition:
      filter 150ms var(--ease-out-site),
      background-color 150ms var(--ease-out-site),
      outline-color 150ms var(--ease-out-site);
    outline: 2px solid transparent;
    outline-offset: 2px;
  }
  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-on-fill);
  }
  .btn-primary:hover {
    filter: brightness(0.88);
  }
  .btn-primary:focus-visible {
    outline-color: var(--color-accent);
  }
  .btn-secondary {
    background-color: transparent;
    color: var(--color-accent);
  }
  .btn-secondary:hover {
    background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }
  .btn-secondary:focus-visible {
    outline-color: var(--color-accent);
  }
</style>
