---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import { categoryColors, categoryTextColors, defaultCategoryTextColor, formatArticleDate, estimateReadingTime } from "../lib/blog";

// Aperçu "À la une" — piloté par la collection de contenu réelle
// (src/content/blog), reprise de l'ancien blog Substack de Jeune
// Chrétien. Le plus récent article en avant, les trois suivants en
// aperçu ; tout renvoie vers de vraies pages /blog/[slug].
const articles = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const [featured, ...rest] = articles;
const subItems = rest.slice(0, 3);
---

<section id="a-la-une" class="container-content px-4 py-24 sm:px-6 lg:py-32">
  <div class="reveal-group flex flex-col items-start gap-6">
    <p class="kicker">À la une</p>
    <h2 class="max-w-xl">Des contenus pour réfléchir, apprendre et grandir.</h2>
  </div>

  <a href={`/blog/${featured.id}`} class="featured-card card-hover reveal-group mt-12 lg:mt-16">
    <div class="featured-media card-hover-media reveal-photo">
      {
        featured.data.image ? (
          <Image
            src={featured.data.image}
            alt={featured.data.imageAlt ?? ""}
            class="w-full h-full object-cover"
            style="aspect-ratio: 3/2;"
            widths={[400, 640, 800, 1200]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            loading="lazy"
          />
        ) : (
          <MediaPlaceholder
            ratio="3/2"
            label={`Photo à venir – ${featured.data.title}`}
            class="h-full w-full"
            hideLabel
          />
        )
      }
    </div>
    <div class="featured-content">
      <span
        class="category-badge"
        style={`background-color: ${categoryColors[featured.data.category]}; color: ${categoryTextColors[featured.data.category] ?? defaultCategoryTextColor};`}
      >
        {featured.data.categoryLabel}
      </span>
      <h3 class="featured-title">{featured.data.title}</h3>
      <p class="featured-summary">{featured.data.excerpt}</p>
      <p class="featured-meta">
        <span>{formatArticleDate(featured.data.date)}</span>
        <span aria-hidden="true">·</span>
        <span>{estimateReadingTime(featured.body ?? "")}</span>
      </p>
      <span class="btn-primary">Lire l'article</span>
    </div>
  </a>

  <div class="sub-items mt-10 grid gap-5 sm:gap-8 sm:grid-cols-3 lg:mt-12">
    {
      subItems.map((item) => (
        <a href={`/blog/${item.id}`} class="reveal-item sub-card card-hover">
          <div class="sub-thumb card-hover-media reveal-photo">
            {item.data.image ? (
              <Image
                src={item.data.image}
                alt={item.data.imageAlt ?? ""}
                class="h-full w-full object-cover"
                style="aspect-ratio: 1/1;"
                widths={[150, 250, 350, 500, 700, 1000]}
                sizes="(min-width: 640px) 30vw, 4.5rem"
                loading="lazy"
              />
            ) : (
              <MediaPlaceholder
                ratio="1/1"
                label={`Photo à venir – ${item.data.title}`}
                class="h-full w-full"
                hideLabel
              />
            )}
          </div>
          <div class="sub-text">
            <span class="sub-type">{item.data.type}</span>
            <h4 class="sub-title">{item.data.title}</h4>
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-12 lg:mt-16">
    <a href="/blog" class="cta-text">
      <span>Voir tous les articles</span>
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  section {
    scroll-margin-top: 6.5rem;
  }

  .kicker {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* Carte éditoriale principale — image ~55%, contenu ~45% à partir de lg.
     L'image a ses propres bords arrondis (plutôt qu'un radius partagé sur
     toute la carte) : sans ça, seuls les coins extérieurs de la carte
     étaient arrondis et les coins de l'image côté texte restaient carrés. */
  .featured-card {
    display: grid;
    gap: 2rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  @media (min-width: 64rem) {
    .featured-card {
      grid-template-columns: 55fr 45fr;
      gap: 3rem;
      align-items: center;
    }
  }

  .featured-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .featured-content {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1rem;
  }

  .category-badge {
    display: inline-block;
    border-radius: 9999px;
    padding-inline: 0.75rem;
    padding-block: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    /* Couleur de texte fixe par défaut (pas var(--color-ink), qui
       s'éclaircit en thème sombre) : ce badge repose sur un aplat de
       couleur de catégorie qui ne change jamais avec le thème. La valeur
       ci-dessous n'est qu'un repli — la couleur réelle est posée en ligne
       (voir categoryTextColors dans lib/blog.ts), certaines catégories
       (ex. "foi") ayant un aplat trop foncé pour un texte sombre. */
    color: #070500;
  }

  .featured-title {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    line-height: 1.2;
  }

  .featured-summary {
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    max-width: 42rem;
  }

  .featured-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    padding-inline: 1.75rem;
    padding-block: 0.875rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    background-color: var(--color-accent);
    color: var(--color-on-fill);
    border: 1px solid var(--color-accent);
    transition: filter 150ms var(--ease-out-site);
  }
  .featured-card:hover .btn-primary,
  .featured-card:focus-visible .btn-primary {
    filter: brightness(0.88);
  }

  /* Mobile : rangée compacte (vignette + texte) — ces contenus sont
     secondaires, ils ne doivent pas prendre toute la largeur de l'écran.
     À partir de sm : carte verticale classique dans la grille 3 colonnes. */
  .sub-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  @media (min-width: 40rem) {
    .sub-card {
      flex-direction: column;
      align-items: start;
      gap: 0.75rem;
    }
  }

  .sub-thumb {
    position: relative;
    width: 4.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 40rem) {
    .sub-thumb {
      width: 100%;
    }
  }

  .sub-text {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .sub-type {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .sub-title {
    font-weight: 600;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }

  .cta-text {
    position: relative;
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
  }
  .cta-text::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out-site);
  }
  .cta-text:hover,
  .cta-text:focus-visible {
    color: var(--color-accent);
  }
  .cta-text:hover::after,
  .cta-text:focus-visible::after {
    transform: scaleX(1);
  }
  .cta-arrow {
    transition: transform 150ms var(--ease-out-site);
  }
  .cta-text:hover .cta-arrow,
  .cta-text:focus-visible .cta-arrow {
    transform: translateX(4px);
  }
</style>
