---
// Page statique, prégénérée au build.
export const prerender = true;

import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import MediaPlaceholder from "../../components/MediaPlaceholder.astro";
import SuivreChaineWhatsApp from "../../components/SuivreChaineWhatsApp.astro";
import { categoryColors, categoryTextColors, defaultCategoryTextColor, formatArticleDate } from "../../lib/blog";

const articles = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Notre blog – Jeune Chrétien"
  description="Articles, témoignages, interviews : les contenus de Jeune Chrétien pour t'aider à grandir dans ta foi, tes études et ta vie professionnelle."
>
  <main>
    <section class="container-content px-4 py-20 sm:px-6 lg:py-28">
      <div class="reveal-group flex flex-col items-start gap-4">
        <p class="kicker">Notre blog</p>
        <h1 class="page-title max-w-2xl">
          Des contenus pour réfléchir, apprendre et grandir.
        </h1>
        <p class="max-w-xl text-ink/70">
          Articles, témoignages et interviews de la communauté Jeune
          Chrétien.
        </p>
      </div>

      <div class="articles-grid reveal-group mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
        {
          articles.map((article) => (
            <a href={`/blog/${article.id}`} class="article-card card-hover reveal-item">
              <div class="article-media card-hover-media reveal-photo">
                {article.data.image ? (
                  <Image
                    src={article.data.image}
                    alt={article.data.imageAlt ?? ""}
                    class="h-full w-full object-cover"
                    style="aspect-ratio: 3/2;"
                    widths={[300, 500, 700, 900]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                    loading="lazy"
                  />
                ) : (
                  <MediaPlaceholder
                    ratio="3/2"
                    label={`Photo à venir – ${article.data.title}`}
                    class="h-full w-full"
                    hideLabel
                  />
                )}
              </div>
              <div class="article-content">
                <span
                  class="category-badge"
                  style={`background-color: ${categoryColors[article.data.category]}; color: ${categoryTextColors[article.data.category] ?? defaultCategoryTextColor};`}
                >
                  {article.data.categoryLabel}
                </span>
                <h2 class="article-title">{article.data.title}</h2>
                <p class="article-excerpt">{article.data.excerpt}</p>
                <p class="article-meta">
                  <span>{article.data.type}</span>
                  <span aria-hidden="true">·</span>
                  <span>{formatArticleDate(article.data.date)}</span>
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="container-content px-4 pb-20 sm:px-6 lg:pb-28">
      <div class="reveal-group blog-wa flex flex-col items-center gap-3 px-6 py-10 text-center">
        <p class="blog-wa-title">Ne passe plus à côté de nos prochains contenus.</p>
        <p class="max-w-md text-ink/70">
          Retrouve les nouveaux articles, vidéos, ressources et initiatives
          de Jeune Chrétien directement sur notre chaîne WhatsApp.
        </p>
        <SuivreChaineWhatsApp location="blog" />
      </div>
    </section>
  </main>
</Layout>

<style>
  .kicker {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .page-title {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 3rem);
    line-height: 1.15;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .article-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article-content {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.625rem;
  }

  .category-badge {
    display: inline-block;
    border-radius: 9999px;
    padding-inline: 0.75rem;
    padding-block: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    /* Couleur fixe : ce badge repose sur un aplat de couleur de catégorie
       qui ne change jamais avec le thème, le texte doit donc rester sombre. */
    color: #070500;
  }

  .article-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .article-excerpt {
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--color-ink) 65%, transparent);
  }

  .article-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  .blog-wa {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .blog-wa-title {
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.625rem);
    font-weight: 600;
    line-height: 1.25;
  }
</style>
