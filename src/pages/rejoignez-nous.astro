<script>
  const flow = document.getElementById("candidature-flow");
  const confirmation = document.getElementById("candidature-confirmation");
  const confirmationRef = confirmation?.querySelector<HTMLElement>('[data-role="confirmation-id"]');

  const form = document.getElementById("candidature-form") as HTMLFormElement | null;
  const eligibleFields = document.getElementById("eligible-fields");
  const minorNotice = document.getElementById("minor-notice");
  const faithNotice = document.getElementById("faith-notice");
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement | null;
  const formError = document.getElementById("form-error");
  const websiteInput = document.getElementById("website") as HTMLInputElement | null;

  const dateNaissanceInput = document.getElementById("dateNaissance") as HTMLInputElement | null;

  function todayISO(): string {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  }
  // Empêche la sélection d'une date de naissance future directement dans
  // le sélecteur natif, en plus de la validation JS/serveur.
  if (dateNaissanceInput) dateNaissanceInput.max = todayISO();

  function computeAge(dateStr: string): number | null {
    const birth = new Date(dateStr);
    if (Number.isNaN(birth.getTime())) return null;
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    const hadBirthday =
      today.getMonth() > birth.getMonth() ||
      (today.getMonth() === birth.getMonth() && today.getDate() >= birth.getDate());
    if (!hadBirthday) age -= 1;
    return age;
  }

  function showError(errorId: string, message: string) {
    const el = document.getElementById(errorId);
    if (!el) return;
    el.textContent = message;
    el.hidden = false;
    const input = document.getElementById(errorId.replace("error-", ""));
    input?.setAttribute("aria-invalid", "true");
  }
  function clearAllErrors() {
    document.querySelectorAll<HTMLElement>(".field-error").forEach((el) => {
      el.hidden = true;
      el.textContent = "";
    });
    document.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
    if (formError) {
      formError.hidden = true;
      formError.textContent = "";
    }
  }

  // --- Blocage d'éligibilité (âge, profession de foi, vie d'église) -----
  // Tant qu'une de ces conditions n'est pas remplie, les parties C/D/E et
  // le bouton d'envoi restent masqués et leur contenu n'est pas collecté.
  function updateEligibility(): boolean {
    const age = dateNaissanceInput?.value ? computeAge(dateNaissanceInput.value) : null;
    const isMinor = age !== null && age < 18;

    const professionDeFoi = document.querySelector<HTMLInputElement>(
      'input[name="professionDeFoi"]:checked'
    )?.value;
    const participeEglise = document.querySelector<HTMLInputElement>(
      'input[name="participeEglise"]:checked'
    )?.value;
    // Un seul "Non" suffit à bloquer — pas besoin d'attendre que les deux
    // questions aient reçu une réponse (brief section 6, partie B).
    const faithFails = professionDeFoi === "non" || participeEglise === "non";

    if (minorNotice) minorNotice.hidden = !isMinor;
    if (faithNotice) faithNotice.hidden = !faithFails;

    const blocked = isMinor || faithFails;
    if (eligibleFields) {
      eligibleFields.hidden = blocked;
      // On vide les champs masqués : on ne conserve pas de données
      // inutiles une fois l'inéligibilité détectée.
      if (blocked) {
        eligibleFields
          .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea")
          .forEach((el) => {
            if (el instanceof HTMLInputElement && (el.type === "checkbox" || el.type === "radio")) {
              el.checked = false;
            } else {
              el.value = "";
            }
          });
      }
    }
    return !blocked;
  }

  dateNaissanceInput?.addEventListener("change", updateEligibility);
  document
    .querySelectorAll<HTMLInputElement>('input[name="professionDeFoi"], input[name="participeEglise"]')
    .forEach((el) => el.addEventListener("change", updateEligibility));

  // --- Validation ---------------------------------------------------------
  function isPlausibleEmail(value: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
  }
  function isPlausiblePhone(value: string): boolean {
    const digitCount = (value.match(/\d/g) ?? []).length;
    return digitCount >= 8 && /^[0-9+()\-.\s]+$/.test(value);
  }
  function isPlausibleUrl(value: string): boolean {
    try {
      const url = new URL(value.includes("://") ? value : `https://${value}`);
      return url.hostname.includes(".");
    } catch {
      return false;
    }
  }
  function val(id: string): string {
    return ((document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? "").trim();
  }

  interface ValidationResult {
    ok: boolean;
    firstInvalid: HTMLElement | null;
    payload: Record<string, unknown> | null;
  }

  function validate(): ValidationResult {
    clearAllErrors();
    let firstInvalid: HTMLElement | null = null;
    const fail = (id: string, errorId: string, message: string) => {
      showError(errorId, message);
      if (!firstInvalid) {
        firstInvalid = document.getElementById(id) ?? document.getElementById(errorId);
      }
    };

    // Partie A
    if (!val("nom")) fail("nom", "error-nom", "Merci d'indiquer ton nom.");
    if (!val("prenoms")) fail("prenoms", "error-prenoms", "Merci d'indiquer tes prénoms.");
    const dateNaissance = val("dateNaissance");
    if (!dateNaissance) {
      fail("dateNaissance", "error-dateNaissance", "Merci d'indiquer ta date de naissance.");
    } else {
      const birth = new Date(dateNaissance);
      if (Number.isNaN(birth.getTime()) || birth.getTime() > Date.now()) {
        fail("dateNaissance", "error-dateNaissance", "La date de naissance n'est pas valide.");
      }
    }
    if (!val("ville")) fail("ville", "error-ville", "Merci d'indiquer ta ville de résidence.");
    if (!val("pays")) fail("pays", "error-pays", "Merci d'indiquer ton pays de résidence.");
    const telephone = val("telephone");
    if (!telephone) {
      fail("telephone", "error-telephone", "Merci d'indiquer un numéro de téléphone.");
    } else if (!isPlausiblePhone(telephone)) {
      fail("telephone", "error-telephone", "Ce numéro de téléphone ne semble pas valide.");
    }
    const email = val("email");
    if (!email) {
      fail("email", "error-email", "Merci d'indiquer une adresse e-mail.");
    } else if (!isPlausibleEmail(email)) {
      fail("email", "error-email", "Cette adresse e-mail ne semble pas valide.");
    }

    // L'éligibilité (âge + partie B) bloque l'envoi — message déjà affiché
    // par updateEligibility(), on arrête juste la validation/l'envoi ici.
    const eligible = updateEligibility();
    if (!eligible) {
      return {
        ok: false,
        firstInvalid: (minorNotice?.hidden === false ? minorNotice : faithNotice) ?? null,
        payload: null,
      };
    }

    if (!val("egliseNom")) fail("egliseNom", "error-egliseNom", "Merci d'indiquer le nom de ton église locale.");
    if (!val("egliseVille")) fail("egliseVille", "error-egliseVille", "Merci d'indiquer la ville de ton église.");

    // Partie C
    const competences = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="competences"]:checked')
    ).map((el) => el.value);
    if (competences.length === 0) {
      fail("competences", "error-competences", "Sélectionne au moins un domaine de compétence.");
    }
    const experience = val("experience");
    if (!experience) {
      fail("experience", "error-experience", "Merci de présenter ton expérience.");
    } else if (experience.length < 20) {
      fail("experience", "error-experience", "Merci de détailler un peu plus ton expérience.");
    }
    const portfolioUrl = val("portfolioUrl");
    if (portfolioUrl && !isPlausibleUrl(portfolioUrl)) {
      fail("portfolioUrl", "error-portfolioUrl", "Ce lien ne semble pas valide.");
    }

    // Partie D
    const motivation = val("motivation");
    if (!motivation) {
      fail("motivation", "error-motivation", "Merci de répondre à cette question.");
    } else if (motivation.length < 30) {
      fail("motivation", "error-motivation", "Merci de développer un peu plus ta réponse.");
    }
    const contribution = val("contribution");
    if (!contribution) {
      fail("contribution", "error-contribution", "Merci de répondre à cette question.");
    } else if (contribution.length < 30) {
      fail("contribution", "error-contribution", "Merci de développer un peu plus ta réponse.");
    }
    const disponibilite = document.querySelector<HTMLInputElement>('input[name="disponibilite"]:checked')?.value;
    if (!disponibilite) {
      fail("disponibilite", "error-disponibilite", "Merci d'indiquer ta disponibilité.");
    }

    // Partie E
    const consentIds = ["aAccepteStatuts", "aAccepteReglement", "certifieExactitude", "aAccepteConfidentialite"];
    const allConsented = consentIds.every(
      (id) => (document.getElementById(id) as HTMLInputElement | null)?.checked
    );
    if (!allConsented) {
      fail(
        "aAccepteStatuts",
        "error-consents",
        "Merci de cocher les quatre cases de confirmation avant d'envoyer ta candidature."
      );
    }

    return {
      ok: !firstInvalid,
      firstInvalid,
      payload: firstInvalid
        ? null
        : {
            nom: val("nom"),
            prenoms: val("prenoms"),
            dateNaissance,
            ville: val("ville"),
            pays: val("pays"),
            telephone,
            email,
            professionDeFoi:
              document.querySelector<HTMLInputElement>('input[name="professionDeFoi"]:checked')?.value === "oui",
            egliseNom: val("egliseNom"),
            egliseVille: val("egliseVille"),
            participeEglise:
              document.querySelector<HTMLInputElement>('input[name="participeEglise"]:checked')?.value === "oui",
            competences,
            experience,
            portfolioUrl,
            motivation,
            contribution,
            disponibilite,
            aAccepteStatuts: (document.getElementById("aAccepteStatuts") as HTMLInputElement | null)?.checked === true,
            aAccepteReglement:
              (document.getElementById("aAccepteReglement") as HTMLInputElement | null)?.checked === true,
            certifieExactitude:
              (document.getElementById("certifieExactitude") as HTMLInputElement | null)?.checked === true,
            aAccepteConfidentialite:
              (document.getElementById("aAccepteConfidentialite") as HTMLInputElement | null)?.checked === true,
            website: websiteInput?.value ?? "",
          },
    };
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const result = validate();
    if (!result.ok) {
      if (formError) {
        formError.textContent = "Merci de corriger les champs signalés avant d'envoyer ta candidature.";
        formError.hidden = false;
      }
      result.firstInvalid?.scrollIntoView({ behavior: "smooth", block: "center" });
      result.firstInvalid?.focus?.();
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Envoi en cours...";
    }

    try {
      const response = await fetch("/api/rejoignez-nous", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(result.payload),
      });

      const data = await response.json().catch(() => null);

      if (!response.ok || !data?.ok) {
        if (formError) {
          formError.textContent =
            data?.message ??
            "Nous n'avons pas pu transmettre ta candidature. Veuillez réessayer ou contacter l'équipe de Jeune Chrétien.";
          formError.hidden = false;
        }
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "Envoyer ma candidature";
        }
        formError?.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }

      if (confirmationRef && data.id) {
        confirmationRef.textContent = `Référence de ta candidature : ${String(data.id).slice(0, 8)}`;
      }

      if (flow) flow.hidden = true;
      if (confirmation) {
        confirmation.hidden = false;
        confirmation.focus();
        confirmation.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    } catch {
      if (formError) {
        formError.textContent =
          "Nous n'avons pas pu transmettre ta candidature. Vos informations n'ont pas été confirmées comme reçues. Veuillez réessayer ou contacter l'équipe de Jeune Chrétien.";
        formError.hidden = false;
      }
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Envoyer ma candidature";
      }
    }
  });
</script>
