---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  getSupabaseClient,
  updateCandidature,
  type Candidature,
  type CandidatureStatut,
  type CandidatureDisponibilite,
} from "../../lib/supabase";

const statutLabels: Record<CandidatureStatut, string> = {
  a_examiner: "À examiner",
  en_cours: "En cours d'examen",
  admis: "Admis",
  refuse: "Refusé",
};

const statutOptions: CandidatureStatut[] = ["a_examiner", "en_cours", "admis", "refuse"];

const disponibiliteLabels: Record<CandidatureDisponibilite, string> = {
  quelques_heures_semaine: "Quelques heures par semaine",
  quelques_heures_mois: "Quelques heures par mois",
  selon_besoins: "Selon les projets et les besoins",
};

const skillLabels: Record<string, string> = {
  "redaction-seo": "Rédaction web & SEO",
  journalisme: "Journalisme",
  "community-management": "Community management",
  "creation-contenus": "Création de contenus",
  "conception-graphique": "Conception graphique",
  "montage-video": "Montage vidéo",
  photographie: "Photographie",
  "motion-design": "Motion design",
  "voix-off": "Voix-off",
  evenementiel: "Événementiel",
  "animation-scene": "Animation de scène / MC",
  autre: "Autre domaine connexe",
};

const supabase = getSupabaseClient();
let actionError: string | null = null;

// Même mécanisme POST → redirection que /admin/messages.astro.
if (supabase && Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");
  const candidatureId = String(formData.get("candidatureId") ?? "");

  if (candidatureId && action === "set-statut") {
    const statut = String(formData.get("statut") ?? "");
    if ((statutOptions as string[]).includes(statut)) {
      const { error } = await updateCandidature(supabase, candidatureId, {
        statut: statut as CandidatureStatut,
      });
      if (error) actionError = "Impossible de mettre à jour le statut.";
    }
  }

  if (!actionError) {
    return Astro.redirect(Astro.url.pathname + Astro.url.search);
  }
}

const filter = Astro.url.searchParams.get("filter") ?? "all";

let candidatures: Candidature[] = [];
let loadError: string | null = null;

if (supabase) {
  let query = supabase.from("candidatures").select("*").order("created_at", { ascending: false });
  if (filter !== "all") {
    query = query.eq("statut", filter);
  }
  const { data, error } = await query;
  if (error) {
    loadError = "Impossible de charger les candidatures.";
  } else {
    candidatures = (data ?? []) as Candidature[];
  }
}

const filters = [
  { key: "all", label: "Toutes" },
  { key: "a_examiner", label: "À examiner" },
  { key: "en_cours", label: "En cours" },
  { key: "admis", label: "Admises" },
  { key: "refuse", label: "Refusées" },
] as const;

const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  hour: "2-digit",
  minute: "2-digit",
});
const birthDateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<AdminLayout title="Candidatures">
  <main class="admin-main">
    <header class="admin-header">
      <div>
        <p class="admin-kicker">Espace interne</p>
        <h1 class="admin-title">Rejoignez-nous – Candidatures</h1>
        <p class="admin-subnav"><a href="/admin/messages">Voir les messages « Parle-nous » →</a></p>
      </div>
      <form method="POST" action="/api/admin/logout">
        <button type="submit" class="logout-button">Se déconnecter</button>
      </form>
    </header>

    {!supabase && (
      <p class="admin-notice">
        Supabase n'est pas encore configuré : renseigner <code>SUPABASE_URL</code> et{" "}
        <code>SUPABASE_SERVICE_ROLE_KEY</code> dans <code>.env</code> (voir{" "}
        <code>.env.example</code> et <code>supabase/schema.sql</code>) pour que les candidatures
        reçues via « Rejoignez-nous » apparaissent ici.
      </p>
    )}

    {loadError && <p class="admin-error">{loadError}</p>}
    {actionError && <p class="admin-error">{actionError}</p>}

    {supabase && (
      <>
        <nav class="filters" aria-label="Filtrer par statut">
          {
            filters.map((f) => (
              <a
                href={f.key === "all" ? "/admin/candidatures" : `/admin/candidatures?filter=${f.key}`}
                class="filter-link"
                aria-current={filter === f.key ? "page" : undefined}
              >
                {f.label}
              </a>
            ))
          }
        </nav>

        {candidatures.length === 0 ? (
          <p class="empty-state">Aucune candidature pour le moment.</p>
        ) : (
          <ul class="candidature-list">
            {
              candidatures.map((c) => (
                <li class="candidature-card">
                  <div class="candidature-meta">
                    <span class={`statut-badge statut-${c.statut}`}>{statutLabels[c.statut]}</span>
                    <span class="candidature-date">{dateFormatter.format(new Date(c.created_at))}</span>
                  </div>

                  <h2 class="candidature-name">{c.prenoms} {c.nom}</h2>

                  <dl class="candidature-details">
                    <div>
                      <dt>Né(e) le</dt>
                      <dd>{birthDateFormatter.format(new Date(c.date_naissance))}</dd>
                    </div>
                    <div>
                      <dt>Localisation</dt>
                      <dd>{c.ville}, {c.pays}</dd>
                    </div>
                    <div>
                      <dt>Contact</dt>
                      <dd>
                        <a href={`mailto:${c.email}`}>{c.email}</a> · {c.telephone}
                      </dd>
                    </div>
                    <div>
                      <dt>Église locale</dt>
                      <dd>{c.eglise_nom} ({c.eglise_ville})</dd>
                    </div>
                    <div>
                      <dt>Compétences</dt>
                      <dd>{c.competences.map((s) => skillLabels[s] ?? s).join(", ")}</dd>
                    </div>
                    <div>
                      <dt>Disponibilité</dt>
                      <dd>{disponibiliteLabels[c.disponibilite]}</dd>
                    </div>
                    {c.portfolio_url && (
                      <div>
                        <dt>Portfolio</dt>
                        <dd>
                          <a href={c.portfolio_url} target="_blank" rel="noopener noreferrer">
                            {c.portfolio_url}
                          </a>
                        </dd>
                      </div>
                    )}
                  </dl>

                  <div class="candidature-text-block">
                    <p class="text-label">Expérience et réalisations</p>
                    <p class="text-content">{c.experience}</p>
                  </div>
                  <div class="candidature-text-block">
                    <p class="text-label">Pourquoi devenir membre</p>
                    <p class="text-content">{c.motivation}</p>
                  </div>
                  <div class="candidature-text-block">
                    <p class="text-label">Contribution envisagée</p>
                    <p class="text-content">{c.contribution}</p>
                  </div>

                  <div class="candidature-actions">
                    <form method="POST" class="statut-form">
                      <input type="hidden" name="candidatureId" value={c.id} />
                      <input type="hidden" name="action" value="set-statut" />
                      <select name="statut" class="statut-select" data-autosubmit>
                        {
                          statutOptions.map((statut) => (
                            <option value={statut} selected={statut === c.statut}>
                              {statutLabels[statut]}
                            </option>
                          ))
                        }
                      </select>
                    </form>
                  </div>
                </li>
              ))
            }
          </ul>
        )}
      </>
    )}
  </main>
</AdminLayout>

<style>
  .admin-main {
    max-width: 64rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .admin-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .admin-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .admin-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .admin-subnav {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
  }
  .admin-subnav a {
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .admin-subnav a:hover {
    color: var(--color-accent);
  }

  .logout-button {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: none;
    color: var(--color-ink);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .logout-button:hover {
    border-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }

  .admin-notice,
  .admin-error {
    margin-bottom: 1.5rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .admin-notice {
    background-color: color-mix(in srgb, var(--color-ink) 6%, transparent);
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }
  .admin-error {
    background-color: color-mix(in srgb, #b3261e 8%, transparent);
    color: #8c1d17;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filter-link {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    color: color-mix(in srgb, var(--color-ink) 65%, transparent);
    font-size: 0.875rem;
    text-decoration: none;
    transition: border-color 150ms var(--ease-out-site);
  }
  .filter-link:hover {
    border-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .filter-link[aria-current="page"] {
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
    font-weight: 600;
  }

  .empty-state {
    padding: 3rem 0;
    text-align: center;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .candidature-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .candidature-card {
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .candidature-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
  }

  .statut-badge {
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-weight: 600;
    background-color: color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }
  .statut-badge.statut-a_examiner {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }
  .statut-badge.statut-admis {
    background-color: color-mix(in srgb, #1e8e3e 14%, transparent);
    color: #1e8e3e;
  }
  .statut-badge.statut-refuse {
    background-color: color-mix(in srgb, #b3261e 10%, transparent);
    color: #8c1d17;
  }

  .candidature-date {
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .candidature-name {
    margin-bottom: 0.875rem;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .candidature-details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
  }
  @media (min-width: 40rem) {
    .candidature-details {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .candidature-details dt {
    color: color-mix(in srgb, var(--color-ink) 50%, transparent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .candidature-details dd {
    margin-top: 0.125rem;
  }
  .candidature-details a {
    color: var(--color-accent);
  }

  .candidature-text-block {
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .text-label {
    margin-bottom: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-ink) 50%, transparent);
  }
  .text-content {
    white-space: pre-wrap;
    line-height: 1.6;
  }

  .candidature-actions {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .statut-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-ink);
    font-size: 0.8125rem;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLSelectElement>("select[data-autosubmit]").forEach((select) => {
    select.addEventListener("change", () => {
      select.form?.requestSubmit();
    });
  });
</script>
