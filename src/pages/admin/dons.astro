---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getSupabaseClient, updateDon, type Don, type DonStatut } from "../../lib/supabase";
import { CURRENCY } from "../../lib/dons-config";

const statutLabels: Record<DonStatut, string> = {
  en_attente_configuration: "Intention (paiement non activé)",
  initie: "Initié (redirigé vers nyole)",
  en_attente: "En attente de confirmation",
  reussi: "Réussi",
  echoue: "Échoué",
  annule: "Annulé",
  rembourse: "Remboursé",
};

const statutOptions: DonStatut[] = [
  "en_attente_configuration",
  "initie",
  "en_attente",
  "reussi",
  "echoue",
  "annule",
  "rembourse",
];

const supabase = getSupabaseClient();
let actionError: string | null = null;

if (supabase && Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");
  const donId = String(formData.get("donId") ?? "");

  if (donId && action === "set-statut") {
    const statut = String(formData.get("statut") ?? "");
    if ((statutOptions as string[]).includes(statut)) {
      const { error } = await updateDon(supabase, donId, { statut: statut as DonStatut });
      if (error) actionError = "Impossible de mettre à jour le statut.";
    }
  }

  if (!actionError) {
    return Astro.redirect(Astro.url.pathname + Astro.url.search);
  }
}

const filter = Astro.url.searchParams.get("filter") ?? "all";

let dons: Don[] = [];
let loadError: string | null = null;

if (supabase) {
  let query = supabase.from("dons").select("*").order("created_at", { ascending: false });
  if (filter !== "all") {
    query = query.eq("statut", filter);
  }
  const { data, error } = await query;
  if (error) {
    loadError = "Impossible de charger les dons.";
  } else {
    dons = (data ?? []) as Don[];
  }
}

const filters = [
  { key: "all", label: "Tous" },
  { key: "en_attente_configuration", label: "Intentions" },
  { key: "initie", label: "Initiés" },
  { key: "en_attente", label: "En attente" },
  { key: "reussi", label: "Réussis" },
  { key: "echoue", label: "Échoués" },
  { key: "annule", label: "Annulés" },
  { key: "rembourse", label: "Remboursés" },
] as const;

const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  hour: "2-digit",
  minute: "2-digit",
});
---

<AdminLayout title="Dons">
  <main class="admin-main">
    <header class="admin-header">
      <div>
        <p class="admin-kicker">Espace interne</p>
        <h1 class="admin-title">Soutenez-nous – Dons</h1>
        <p class="admin-subnav">
          <a href="/admin/messages">Messages « Parle-nous »</a> ·{" "}
          <a href="/admin/candidatures">Candidatures « Rejoignez-nous »</a>
        </p>
      </div>
      <form method="POST" action="/api/admin/logout">
        <button type="submit" class="logout-button">Se déconnecter</button>
      </form>
    </header>

    <p class="admin-notice">
      Prestataire de paiement : nyole. Tant qu'aucune clé n'est configurée
      (voir <code>src/lib/dons-config.ts</code>), chaque ligne au statut{" "}
      <strong>« Intention »</strong> est un don souhaité par un visiteur — à
      recontacter manuellement, pas un paiement reçu. Les statuts « Réussi »,
      « Échoué », « Annulé » et « Remboursé » sont mis à jour automatiquement
      par le webhook nyole.
    </p>

    {!supabase && (
      <p class="admin-notice">
        Supabase n'est pas encore configuré : renseigner <code>SUPABASE_URL</code> et{" "}
        <code>SUPABASE_SERVICE_ROLE_KEY</code> dans <code>.env</code> pour que les
        intentions de don apparaissent ici.
      </p>
    )}

    {loadError && <p class="admin-error">{loadError}</p>}
    {actionError && <p class="admin-error">{actionError}</p>}

    {supabase && (
      <>
        <nav class="filters" aria-label="Filtrer par statut">
          {
            filters.map((f) => (
              <a
                href={f.key === "all" ? "/admin/dons" : `/admin/dons?filter=${f.key}`}
                class="filter-link"
                aria-current={filter === f.key ? "page" : undefined}
              >
                {f.label}
              </a>
            ))
          }
        </nav>

        {dons.length === 0 ? (
          <p class="empty-state">Aucun don pour le moment.</p>
        ) : (
          <ul class="don-list">
            {
              dons.map((don) => (
                <li class="don-card">
                  <div class="don-meta">
                    <span class={`statut-badge statut-${don.statut}`}>{statutLabels[don.statut]}</span>
                    <span class="don-date">{dateFormatter.format(new Date(don.created_at))}</span>
                  </div>

                  <p class="don-amount">
                    {don.montant.toLocaleString("fr-FR")} {CURRENCY}
                  </p>

                  <dl class="don-details">
                    <div>
                      <dt>Référence</dt>
                      <dd>{don.reference}</dd>
                    </div>
                    <div>
                      <dt>Contact</dt>
                      <dd>
                        <a href={`mailto:${don.email}`}>{don.email}</a>
                        {don.telephone && <> · {don.telephone}</>}
                      </dd>
                    </div>
                    {don.reference_prestataire && (
                      <div>
                        <dt>Référence prestataire</dt>
                        <dd>{don.reference_prestataire}</dd>
                      </div>
                    )}
                    {don.nyole_session_id && (
                      <div>
                        <dt>Session nyole</dt>
                        <dd>{don.nyole_session_id}</dd>
                      </div>
                    )}
                  </dl>

                  <div class="don-actions">
                    <form method="POST" class="statut-form">
                      <input type="hidden" name="donId" value={don.id} />
                      <input type="hidden" name="action" value="set-statut" />
                      <select name="statut" class="statut-select" data-autosubmit>
                        {
                          statutOptions.map((statut) => (
                            <option value={statut} selected={statut === don.statut}>
                              {statutLabels[statut]}
                            </option>
                          ))
                        }
                      </select>
                    </form>
                  </div>
                </li>
              ))
            }
          </ul>
        )}
      </>
    )}
  </main>
</AdminLayout>

<style>
  .admin-main {
    max-width: 56rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .admin-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .admin-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .admin-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .admin-subnav {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
  }
  .admin-subnav a {
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .admin-subnav a:hover {
    color: var(--color-accent);
  }

  .logout-button {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: none;
    color: var(--color-ink);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .logout-button:hover {
    border-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }

  .admin-notice,
  .admin-error {
    margin-bottom: 1.5rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .admin-notice {
    background-color: color-mix(in srgb, var(--color-ink) 6%, transparent);
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }
  .admin-error {
    background-color: color-mix(in srgb, #b3261e 8%, transparent);
    color: #8c1d17;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filter-link {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    color: color-mix(in srgb, var(--color-ink) 65%, transparent);
    font-size: 0.875rem;
    text-decoration: none;
    transition: border-color 150ms var(--ease-out-site);
  }
  .filter-link:hover {
    border-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .filter-link[aria-current="page"] {
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
    font-weight: 600;
  }

  .empty-state {
    padding: 3rem 0;
    text-align: center;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .don-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .don-card {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .don-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.625rem;
    font-size: 0.8125rem;
  }

  .statut-badge {
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-weight: 600;
    background-color: color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }
  .statut-badge.statut-en_attente_configuration {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }
  .statut-badge.statut-reussi {
    background-color: color-mix(in srgb, #1e8e3e 14%, transparent);
    color: #1e8e3e;
  }
  .statut-badge.statut-echoue,
  .statut-badge.statut-annule {
    background-color: color-mix(in srgb, #b3261e 10%, transparent);
    color: #8c1d17;
  }
  .statut-badge.statut-rembourse {
    background-color: color-mix(in srgb, #e37400 12%, transparent);
    color: #a35700;
  }

  .don-date {
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .don-amount {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    font-family: var(--font-display);
  }

  .don-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  .don-details dt {
    color: color-mix(in srgb, var(--color-ink) 50%, transparent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .don-details dd {
    margin-top: 0.125rem;
  }
  .don-details a {
    color: var(--color-accent);
  }

  .don-actions {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .statut-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-ink);
    font-size: 0.8125rem;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLSelectElement>("select[data-autosubmit]").forEach((select) => {
    select.addEventListener("change", () => {
      select.form?.requestSubmit();
    });
  });
</script>
