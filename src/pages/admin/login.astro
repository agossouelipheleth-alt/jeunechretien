---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  verifyAdminPassword,
  createSessionToken,
  isAdminAuthConfigured,
  ADMIN_COOKIE_NAME,
  ADMIN_COOKIE_MAX_AGE_SECONDS,
} from "../../lib/admin-auth";

let error: string | null = null;
const configured = isAdminAuthConfigured();

if (Astro.request.method === "POST") {
  if (!configured) {
    error = "L'accès interne n'est pas encore configuré (variables d'environnement manquantes).";
  } else {
    const formData = await Astro.request.formData();
    const password = String(formData.get("password") ?? "");

    if (verifyAdminPassword(password)) {
      Astro.cookies.set(ADMIN_COOKIE_NAME, createSessionToken(), {
        httpOnly: true,
        secure: import.meta.env.PROD,
        sameSite: "lax",
        path: "/",
        maxAge: ADMIN_COOKIE_MAX_AGE_SECONDS,
      });
      return Astro.redirect("/admin/messages");
    }

    error = "Mot de passe incorrect.";
  }
}
---

<AdminLayout title="Connexion">
  <main class="login-main">
    <form method="POST" class="login-card">
      <p class="login-kicker">Espace interne</p>
      <h1 class="login-title">Parle-nous</h1>

      {!configured && (
        <p class="login-notice">
          Aucun accès n'est encore configuré : renseigner{" "}
          <code>ADMIN_PASSWORD_HASH</code> et <code>ADMIN_SESSION_SECRET</code>{" "}
          dans <code>.env</code> (voir <code>.env.example</code>).
        </p>
      )}
      {error && <p class="login-error">{error}</p>}

      <label class="login-label" for="password">Mot de passe</label>
      <input
        type="password"
        id="password"
        name="password"
        class="login-input"
        required
        autofocus
        autocomplete="current-password"
      />
      <button type="submit" class="btn-primary">Se connecter</button>
    </form>
  </main>
</AdminLayout>

<style>
  .login-main {
    display: flex;
    min-height: 100vh;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .login-card {
    display: flex;
    width: 100%;
    max-width: 22rem;
    flex-direction: column;
    gap: 1rem;
    padding: 2.5rem 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .login-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .login-title {
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .login-label {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .login-input {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-ink);
    font-size: 1rem;
  }
  .login-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .login-error,
  .login-notice {
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
  }
  .login-error {
    background-color: color-mix(in srgb, #b3261e 8%, transparent);
    color: #8c1d17;
  }
  .login-notice {
    background-color: color-mix(in srgb, var(--color-ink) 6%, transparent);
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }
  .login-notice code {
    font-size: 0.8125rem;
  }

  .btn-primary {
    margin-top: 0.5rem;
    padding-block: 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-on-fill);
    font-weight: 500;
    cursor: pointer;
    transition: filter 150ms var(--ease-out-site);
  }
  .btn-primary:hover {
    filter: brightness(0.88);
  }
</style>
